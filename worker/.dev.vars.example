# Copy this file to .dev.vars, fill it in, then run "npm run secrets" to upload to Cloudflare.
# .dev.vars is ignored by git, so these never end up on GitHub.

# From resend.com > API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# From console.neon.tech > your project > Connect (the "postgresql://..." string)
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# The password you'll type to open the dashboard. Make it long.
ADMIN_PASSWORD=choose-a-long-password

# Any long random text. Changing it signs everyone out of the dashboard.
SESSION_SECRET=paste-any-long-random-text-here

# Your Google Sheet link (sharing must be "Anyone with the link: Viewer"), or a "Publish to web" link
PRICE_SHEET_URL=https://docs.google.com/spreadsheets/d/1eOOq9a7rWEjyEBcQWlBjQQcIMzu5n3hD64yEeZ7Xj6M/edit?usp=sharing
