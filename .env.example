# ===========================================================================
#  Santeria Tech settings. Everything lives in this one file.
#
#  1. Copy this file to .env (same folder) and fill it in. .env is ignored by git,
#     so your keys never reach GitHub.
#  2. Run:  npm run deploy
#     It uploads the private settings to your API, builds the website and publishes it
#     to GitHub Pages. Run it again whenever you change something here.
#
#  Don't put quotes around values. Lines starting with # are notes.
#  Only the VITE_ lines go into the public website. Everything else stays private.
# ===========================================================================


# ---- Needed ----------------------------------------------------------------

# Sends the purchase-order emails.
# Where: resend.com > API Keys > Create API Key. Starts with re_
RESEND_API_KEY=

# Saves orders and dashboard logins.
# Where: console.neon.tech > your project > Connect. Copy the whole postgresql://... string.
DATABASE_URL=


# ---- Prices ----------------------------------------------------------------

# Your Google Sheet link. Sharing must be "Anyone with the link: Viewer".
# Leave empty to use the built-in prices.
PRICE_SHEET_URL=


# ---- Email -----------------------------------------------------------------

# Who the order emails come from. Must be on a domain you've verified in Resend > Domains
# (Gmail and atomicmail addresses can't be used). Until then, leave it empty: emails come from
# Resend's test sender and only reach the email you signed up to Resend with.
# Example: Santeria Tech Orders <orders@yourdomain.com>
FROM_EMAIL=

# Who gets each new order. Separate addresses with commas.
TO_EMAILS=santeriatech@atomicmail.io,oswaldamoah00@gmail.com


# ---- Filled in for you by npm run deploy -------------------------------------
# Leave these empty. The deploy fills them from your GitHub repo and Cloudflare.
# Only change them if you use a custom domain.

# Your website's address, for the "Open in dashboard" button in each email.
SITE_URL=

# Websites allowed to send orders and open the dashboard (origins, comma separated).
# A * matches any one part of an address, e.g. https://santeria-tech*.vercel.app for Vercel.
ALLOWED_ORIGINS=

# Your API's address. Public: it's built into the website.
VITE_API_URL=


# ---- Dashboard logins --------------------------------------------------------
# Not set here. Logins live in your Neon database: run database/create-login.sql in
# Neon > SQL Editor (the file says what to change).
